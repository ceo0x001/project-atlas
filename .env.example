# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Postgres (pgvector + pgcrypto extensions required) ---
#
# Two roles, on purpose (ARCHITECTURE §10):
#
#   DATABASE_URL            the application role, `atlas_app`. Not a superuser and
#                           without BYPASSRLS, so row-level security applies to
#                           every query the service makes. The service cannot
#                           bypass tenant isolation because it lacks the
#                           credentials to.
#   DATABASE_MIGRATION_URL  the owner role, `atlas`. Used only by Prisma Migrate,
#                           Introspect and Studio, which must create tables and
#                           policies. Never used by the running service.
#
# The app role is created by the RLS migration. Change its password per environment.
DATABASE_URL=postgresql://atlas_app:atlas_app@localhost:5432/atlas?schema=public
DATABASE_MIGRATION_URL=postgresql://atlas:atlas@localhost:5432/atlas?schema=public

# --- Redis (sessions, cache, rate limits) ---
REDIS_URL=redis://localhost:6379

# --- Temporal (durable workflows, ADR-007) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=atlas-core

# --- Claude (conversation + background classification) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CONVERSATION=claude-fable-5
ANTHROPIC_MODEL_BACKGROUND=claude-haiku-4-5-20251001

# --- Embeddings (memory vector search; dimension must match Prisma schema) ---
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024

# --- Encryption (field-level, per-user data keys under this root) ---
# Generate: openssl rand -base64 32
ENCRYPTION_ROOT_KEY=

# --- Auth ---
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Observability (OpenTelemetry) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atlas-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
